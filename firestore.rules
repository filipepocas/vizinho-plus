rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'rochap.filipe@gmail.com' ||
        getUserData().role == 'admin'
      );
    }

    function isMerchant() {
      return isAuthenticated() && getUserData().role == 'merchant';
    }

    function isValidCashbackTransaction() {
      return request.resource.data.keys().hasAll([
          'clientId',
          'merchantId',
          'merchantName',
          'amount',
          'invoiceAmount',
          'type',
          'status',
          'createdAt',
          'clientNif',
          'documentNumber',
          'clientName',
          'clientCardNumber',
          'clientBirthDate'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId',
          'merchantId',
          'merchantName',
          'amount',
          'invoiceAmount',
          'type',
          'status',
          'createdAt',
          'clientNif',
          'documentNumber',
          'clientName',
          'clientCardNumber',
          'clientBirthDate'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.merchantId is string
        && request.resource.data.merchantName is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.invoiceAmount is number
        && request.resource.data.invoiceAmount > 0
        && request.resource.data.type in ['earn', 'redeem']
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.role == 'client';
    }

    match /users/{userId} {
      // Leitura permitida: próprio utilizador, admin, lojas públicas, ou comerciantes a identificar clientes no terminal
      allow read: if isAdmin()
        || (isAuthenticated() && request.auth.uid == userId)
        || resource.data.role == 'merchant'
        || (isMerchant() && resource.data.role == 'client')
        || resource.data.isPublic == true;

      // Criação: apenas utilizador autenticado a criar o próprio perfil como 'client' ou 'merchant' (pendente), ou Admin a provisionar
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role in ['client', 'merchant'] &&
        (request.resource.data.role == 'client' || request.resource.data.status == 'pending')
      );

      // Carteiras são atualizadas apenas pelo Admin SDK no processador de transações.
      allow update: if isAdmin()
        || (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'wallet', 'storeWallets']))
        );

      // Eliminação: Admin ou o próprio utilizador (Direito ao Esquecimento RGPD)
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.merchantId == request.auth.uid));
      allow create: if isValidCashbackTransaction() &&
        isMerchant() &&
        request.resource.data.merchantId == request.auth.uid;
      allow update: if (
        (isAdmin() || (
          isMerchant() && resource.data.merchantId == request.auth.uid
        )) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']) &&
        resource.data.status == 'available' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.cancelledAt == request.time
      ) || (
        (isAdmin() || (
          isMerchant() && resource.data.merchantId == request.auth.uid
        )) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documentNumber']) &&
        request.resource.data.documentNumber is string
      );
      allow delete: if resource.data.status in ['rejected', 'cancelled'] && (
        isAdmin() ||
        (isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.merchantId == request.auth.uid))
      );
    }

    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    match /vantagens/{vantagemId} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{bannerId} { allow read: if true; allow write: if isAdmin(); }
    match /leaflets/{leafletId} { allow read: if true; allow write: if isAdmin(); }
    match /leaflet_campaigns/{campaignId} { allow read: if true; allow write: if isAdmin(); }
    match /system/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /pricing_rules/{ruleId} { allow read: if true; allow write: if isAdmin(); }

    match /merchant_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    match /marketing_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.merchantId == request.auth.uid);
      allow create: if (isAuthenticated() && request.resource.data.merchantId == request.auth.uid) || request.resource.data.isExternal == true;
      allow update, delete: if isAdmin();
    }

    match /merchant_messages/{msgId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.merchantId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.merchantId == request.auth.uid);
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    match /anti_waste/{itemId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.merchantId == request.auth.uid;
      allow update: if isAdmin(); 
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.merchantId == request.auth.uid);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.merchantId == request.auth.uid);
    }
    
    match /municipalities_faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
